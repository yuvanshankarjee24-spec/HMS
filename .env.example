# Database Connection (Single Shared Pool)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hostel_db
DB_USER=root
DB_PASSWORD=change_me_db_password
DB_TIMEZONE=UTC

# Initial System Administrator Credentials (Read on first boot to seed sole Admin)
ADMIN_USERNAME=your_admin_username_here
ADMIN_PASSWORD=your_admin_password_here

# Password Policy Configuration
FORCE_PASSWORD_CHANGE_ON_FIRST_LOGIN=true

# Application Security & Storage
JWT_SECRET=change_me_at_least_256_bits_long_secret_key_for_hmac_sha256_signing
QR_HMAC_SECRET=change_me_qr_hmac_signing_secret_key_at_least_256_bits_2026
UPLOAD_DIR=./storage/photos

# Display Timezone (DB always stores UTC)
APP_DISPLAY_TIMEZONE=Asia/Kolkata
SPRING_PROFILES_ACTIVE=local
